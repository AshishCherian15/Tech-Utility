{
  "name": "ByteShelf",
  "short_name": "ByteShelf",
  "description": "Your shelf of useful tech",
  "start_url": "/dashboard",
  "display": "standalone",
  "background_color": "#f8f9fc",
  "theme_color": "#4361ee",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
