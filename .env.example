# ──────────────────────────────────────────────────────────────────
# Ash-Tech — Environment Variables
# Copy this to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key — server-side only, NEVER expose to the client
# Used for scheduled jobs and admin operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── AI Autofill ───────────────────────────────────────────────────
# Gemini (free tier) — get from: https://aistudio.google.com/app/apikey
# Leave blank to disable AI autofill (manual form still works perfectly)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (fallback, optional) — get from: https://console.groq.com
# GROQ_API_KEY=your_groq_api_key_here

# ── App ───────────────────────────────────────────────────────────
# The canonical URL of your deployment (used for OAuth redirect URIs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────
# After filling in values:
# 1. Add NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY
#    to your Vercel project's environment variables
# 2. Add SUPABASE_SERVICE_ROLE_KEY and GEMINI_API_KEY as SECRETS
#    (not exposed to the browser) in Vercel
# 3. In Supabase Auth settings:
#    - Disable "Enable email signups" (no public sign-up)
#    - Add your Vercel URL to "Redirect URLs":
#      https://your-app.vercel.app/auth/callback
#    - Enable Google and/or GitHub OAuth providers
# ──────────────────────────────────────────────────────────────────
